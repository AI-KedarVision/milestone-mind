# MilestoneMind environment configuration
# Copy the relevant variables into client/.env.local or server/.env.
# Do not put real credentials in this file.

# Supabase project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable key (safe for frontend use with proper RLS)
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Backend server
PORT=5000
CLIENT_URL=http://localhost:5173

# Add server-only secrets here as placeholders if needed in the future.
# Never commit real secrets.

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# OpenAI
OPENAI_API_KEY=